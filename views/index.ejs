<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QuizNest — Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/output.css">
  <style>
    :root {
      --bg: #08070f;
      --bg-alt: #0c0b17;
      --surface: #131024;
      --surface-2: #17142a;
      --surface-hover: #1c1832;
      --border: rgba(255,255,255,0.08);
      --border-strong: rgba(255,255,255,0.18);
      --primary: #9b5cff;
      --primary-2: #7c3aed;
      --secondary: #22d3ee;
      --text: #f5f3ff;
      --text-dim: #c9c6e0;
      --muted: #8d8aa3;
      --muted-2: #6d6a87;
      --danger: #f0555a;
      --glow-purple: rgba(155,92,255,0.35);
      --glow-cyan: rgba(34,211,238,0.28);
    }
    body {
      font-family: 'Inter', system-ui, sans-serif;
    }
    .font-display {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    }
    .text-gradient {
      background: linear-gradient(90deg, var(--secondary), var(--primary));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    ::-webkit-scrollbar { height: 8px; width: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--surface-2); border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--primary-2); }
  </style>
</head>

<body
  data-sidebar="closed"
  class="bg-[var(--bg)] text-[var(--text)] antialiased min-h-screen flex flex-col justify-between relative overflow-x-hidden
         data-[sidebar=open]:[&_#sidebar]:translate-x-0
         data-[sidebar=open]:[&_#main-content]:lg:ml-[min(280px,20vw)]
         data-[sidebar=open]:[&_#sidebar-backdrop]:opacity-100
         data-[sidebar=open]:[&_#sidebar-backdrop]:pointer-events-auto"
  style="background-image: radial-gradient(circle, rgba(155,92,255,0.16) 1px, transparent 1.6px); background-size: 28px 28px;"
>

  <!-- Ambient background glow spots -->
  <div class="pointer-events-none fixed top-0 left-1/4 w-96 h-96 bg-[var(--primary)]/14 rounded-full blur-3xl -z-10"></div>
  <div class="pointer-events-none fixed bottom-10 right-10 w-80 h-80 bg-[var(--secondary)]/10 rounded-full blur-3xl -z-10"></div>
  <div class="pointer-events-none fixed top-1/3 right-1/4 w-72 h-72 bg-[var(--primary-2)]/10 rounded-full blur-3xl -z-10"></div>

  <!-- ===================== Fixed Header ===================== -->
  <header class="fixed top-0 left-0 right-0 z-50 h-17.5 bg-[var(--bg-alt)]/95 backdrop-blur-md text-[var(--text)] flex items-center justify-between px-4 sm:px-8 border-b border-[var(--border)] shadow-[0_4px_24px_rgba(124,58,237,0.12)]">

    <!-- Left: Menu Toggle + Brand Logo -->
    <div class="flex items-center gap-3">
      <button
        id="menu-toggle"
        type="button"
        aria-label="Toggle sidebar"
        aria-expanded="false"
        class="text-[var(--text-dim)] text-2xl leading-none p-2 rounded-xl hover:bg-white/8 hover:text-[var(--text)] active:scale-95 transition-all duration-200 cursor-pointer"
      >
        ☰
      </button>

      <a href="/dashboard" class="flex items-center gap-2.5 no-underline text-[var(--text)]">
        <span class="w-9 h-9 rounded-xl bg-[linear-gradient(135deg,var(--primary),var(--secondary))] text-white flex items-center justify-center shadow-[0_0_16px_rgba(155,92,255,0.45)] font-bold" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>
        </span>
        <span class="font-display font-extrabold text-2xl tracking-tight hidden sm:inline">Quiz<span class="text-gradient">Nest</span></span>
      </a>
    </div>

    <!-- Center Navigation -->
    <nav class="hidden md:flex items-center gap-1.5 bg-[var(--surface)]/70 p-1.5 rounded-2xl border border-[var(--border)]">
      <a id="dashboard" class="text-white bg-[linear-gradient(135deg,var(--primary),var(--secondary))] text-[14px] font-semibold px-4 py-2 rounded-xl no-underline transition-all duration-300 shadow-[0_0_14px_rgba(155,92,255,0.45)] hover:cursor-pointer">Dashboard</a>
      <a id="uploadquiz" class="text-white text-[14px] font-semibold px-4 py-2 rounded-xl no-underline transition-all duration-300 hover:bg-white/6 hover:text-white hover:cursor-pointer">Upload Quiz</a>
      <a id="viewquiz" class="text-white text-[14px] font-semibold px-4 py-2 rounded-xl no-underline transition-all duration-300 hover:bg-white/6 hover:text-white hover:cursor-pointer" >Your Quizzes</a>
    </nav>

    <!-- Right Actions / Profile -->
    <div class="flex items-center gap-2.5">
    

    <a id="login" href="/login" class="text-white text-[14px] font-semibold px-4 py-2 rounded-xl no-underline transition-all duration-300 bg-[linear-gradient(135deg,var(--primary),var(--secondary))] shadow-[0_0_14px_rgba(155,92,255,0.45)] hover:text-white hover:cursor-pointer">Login</a>
  </header>

  <!-- Mobile Backdrop -->
  <div
    id="sidebar-backdrop"
    class="fixed inset-x-0 top-17.5 bottom-0 z-30 bg-black/50 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out lg:hidden"
    aria-hidden="true"
  ></div>

  <!-- ===================== Sidebar ===================== -->
  <aside
    id="sidebar"
    class="fixed top-17.5 left-0 z-40 h-[calc(100vh-70px)] w-[min(280px,20vw)] bg-[var(--bg-alt)] text-[var(--text)] shadow-[4px_0_28px_rgba(0,0,0,0.35)] -translate-x-full transition-transform duration-300 ease-in-out border-r border-[var(--border)]"
    aria-label="Secondary navigation"
  >
    <nav class="flex flex-col gap-3 p-5 pt-8">
      <a href="#" class="block text-[var(--text-dim)] font-medium text-center py-3 px-5 rounded-xl no-underline transition-all duration-200 hover:bg-white/6 hover:text-[var(--text)] hover:translate-x-1">Profile</a>
      <a href="#" class="block text-[var(--text-dim)] font-medium text-center py-3 px-5 rounded-xl no-underline transition-all duration-200 hover:bg-white/6 hover:text-[var(--text)] hover:translate-x-1">Settings</a>
      <a href="/help" class="block text-[var(--text-dim)] font-medium text-center py-3 px-5 rounded-xl no-underline transition-all duration-200 hover:bg-white/6 hover:text-[var(--text)] hover:translate-x-1">Help</a>

      <div class="my-2 border-t border-[var(--border)]"></div>

      <a id="logout" class="block text-[var(--text-dim)] font-semibold text-center py-3 px-5 rounded-xl no-underline transition-all duration-200 cursor-pointer hover:bg-[var(--danger)]/15 hover:text-[var(--danger)] hover:translate-x-1">Logout</a>
    </nav>
  </aside>

  <!-- ===================== Main Content Wrapper ===================== -->
  <div id="main-content" class="pt-17.5 min-h-screen flex flex-col transition-all duration-300 ease-in-out">
    <main class="max-w-7xl mx-auto px-6 sm:px-10 w-full grow pb-16">

      <!-- Hero Row: Welcome + Join card & AI Banner -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch pt-9">

        <!-- Welcome + Join Quiz Card -->
        <div class="flex flex-col justify-center bg-linear-to-br from-[#1b1030] to-[#14102a] border border-[var(--border)] rounded-3xl p-8 sm:p-9 shadow-[0_0_40px_rgba(124,58,237,0.10)] hover:shadow-[0_0_48px_rgba(124,58,237,0.18)] transition-shadow">
          <div class="inline-flex items-center gap-2 bg-white/6 text-[var(--secondary)] px-3 py-1 rounded-full text-xs font-bold w-fit mb-3 border border-[var(--border)]">
            👋 Welcome back
          </div>
          <h1 class="font-display font-extrabold text-3xl mb-1 text-[var(--text)]">Ready for your next challenge, Alex?</h1>
          <p class="text-[var(--muted)] text-sm mb-6">Enter a quiz pin below to instantly enter the live lobby.</p>

          <form class="flex flex-col sm:flex-row items-stretch w-full bg-[var(--surface)]/80 border border-[var(--border)] rounded-3xl sm:rounded-full shadow-inner overflow-hidden focus-within:ring-2 focus-within:ring-[var(--primary)] transition" id="joinForm">
            <div class="flex-1 flex items-center px-6 py-4 sm:py-0 min-w-0">
              <label for="quizCode" class="sr-only">Quiz code</label>
              <input id="quizCode" name="code" type="text" placeholder="ENTER QUIZ CODE" autocomplete="off" maxlength="10" class="w-full border-none outline-none bg-transparent font-bold text-base tracking-widest uppercase text-[var(--text)] placeholder:text-[var(--muted-2)] placeholder:font-normal placeholder:tracking-normal py-3" />
            </div>

            <!-- Divider -->
            <div class="relative sm:w-0 sm:border-l-2 sm:border-dashed sm:border-[var(--border)] sm:my-2.5 h-0 border-t-2 border-dashed border-[var(--border)] mx-5 sm:mx-0" aria-hidden="true"></div>

            <button type="submit" class="flex items-center justify-center gap-2 m-2 sm:m-1.5 px-7 py-3.5 bg-[linear-gradient(135deg,var(--primary),var(--secondary))] text-white rounded-2xl sm:rounded-full font-bold text-sm whitespace-nowrap shadow-[0_0_18px_rgba(155,92,255,0.4)] hover:shadow-[0_0_26px_rgba(155,92,255,0.6)] hover:brightness-110 transition-all active:scale-95 disabled:opacity-60 cursor-pointer group">
              <span class="btn-label">Join Quiz</span>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition group-hover:translate-x-1"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </form>
        </div>

        <!-- AI Banner -->
        <button type="button" class="w-full flex flex-col sm:flex-row items-center justify-between gap-5 text-left bg-linear-to-r from-[#12102a] via-[#0f0e22] to-[#0c1a28] border border-[var(--border)] rounded-3xl p-8 sm:p-9 shadow-[0_0_40px_rgba(34,211,238,0.08)] hover:-translate-y-1 hover:shadow-[0_0_48px_rgba(34,211,238,0.16)] transition-all active:scale-95 group cursor-pointer">
          <div class="flex-1 min-w-0 flex flex-col items-center sm:items-start gap-2">
            <span class="bg-[linear-gradient(135deg,var(--primary),var(--secondary))] text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-[0_0_12px_rgba(155,92,255,0.4)]">✨ AI Quiz Generator</span>
            <h2 class="font-display text-2xl font-extrabold leading-tight text-[var(--text)] text-center sm:text-left">Generate Your Own Quiz with AI</h2>
            <p class="text-[var(--muted)] text-sm leading-relaxed text-center sm:text-left">Create interactive quizzes in seconds — pick any topic and let AI draft the questions.</p>
            <span class="inline-flex items-center gap-2 mt-2 font-bold text-[var(--secondary)] text-sm group-hover:underline">
              Try it now
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="transition group-hover:translate-x-1"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
          <div class="w-36 sm:w-40 shrink-0" aria-hidden="true">
            <svg viewBox="0 0 300 260" class="w-full h-auto">
              <ellipse cx="150" cy="236" rx="108" ry="12" fill="#9b5cff" opacity="0.10"/>
              <path d="M118 150 Q100 165 108 190" stroke="#22d3ee" stroke-width="16" stroke-linecap="round" fill="none"/>
              <path d="M182 150 Q206 160 197 184" stroke="#22d3ee" stroke-width="16" stroke-linecap="round" fill="none"/>
              <rect x="118" y="120" width="64" height="82" rx="24" fill="#7c3aed"/>
              <circle cx="150" cy="96" r="34" fill="#f6c593"/>
              <path d="M116 92 Q120 52 150 50 Q180 52 184 92 Q170 72 150 70 Q130 72 116 92Z" fill="#3b2a20"/>
              <circle cx="140" cy="98" r="3.4" fill="#20261f"/>
              <circle cx="160" cy="98" r="3.4" fill="#20261f"/>
              <path d="M138 110 Q150 118 162 110" stroke="#20261f" stroke-width="3" fill="none" stroke-linecap="round"/>
              <rect x="40" y="188" width="220" height="18" rx="9" fill="#1c1832"/>
              <rect x="60" y="206" width="14" height="30" rx="6" fill="#1c1832"/>
              <rect x="226" y="206" width="14" height="30" rx="6" fill="#1c1832"/>
              <path d="M110 188 L110 150 Q130 139 150 150 L150 188 Z" fill="#14122a" stroke="#9b5cff" stroke-width="3" stroke-linejoin="round"/>
              <path d="M150 188 L150 150 Q170 139 190 150 L190 188 Z" fill="#14122a" stroke="#22d3ee" stroke-width="3" stroke-linejoin="round"/>
              <line x1="150" y1="150" x2="150" y2="188" stroke="#3a3560" stroke-width="2"/>
              <line x1="118" y1="163" x2="139" y2="163" stroke="#9b5cff" stroke-width="3" stroke-linecap="round" opacity="0.6"/>
              <line x1="118" y1="173" x2="135" y2="173" stroke="#9b5cff" stroke-width="3" stroke-linecap="round" opacity="0.6"/>
              <line x1="161" y1="163" x2="182" y2="163" stroke="#22d3ee" stroke-width="3" stroke-linecap="round" opacity="0.6"/>
              <line x1="161" y1="173" x2="178" y2="173" stroke="#22d3ee" stroke-width="3" stroke-linecap="round" opacity="0.6"/>
              <g transform="translate(150,141) rotate(-20)">
                <rect x="0" y="-4" width="54" height="8" rx="4" fill="#ffd966"/>
                <rect x="48" y="-4" width="8" height="8" fill="#f2a65a"/>
                <rect x="55" y="-3" width="4" height="6" fill="#20261f"/>
              </g>
              <circle cx="235" cy="58" r="20" fill="#0f0e22" stroke="#22d3ee" stroke-width="3"/>
              <path d="M227 54 q8 -11 16 0 q-8 11 -16 0" stroke="#22d3ee" stroke-width="2.4" fill="none"/>
              <rect x="228" y="76" width="14" height="7" rx="2" fill="#22d3ee" opacity="0.8"/>
              <rect x="230" y="84" width="10" height="5" rx="2" fill="#22d3ee" opacity="0.8"/>
              <line x1="235" y1="26" x2="235" y2="18" stroke="#22d3ee" stroke-width="3" stroke-linecap="round"/>
              <line x1="256" y1="40" x2="262" y2="34" stroke="#22d3ee" stroke-width="3" stroke-linecap="round"/>
              <line x1="214" y1="40" x2="208" y2="34" stroke="#22d3ee" stroke-width="3" stroke-linecap="round"/>
              <circle cx="66" cy="52" r="18" fill="#14122a" stroke="#9b5cff" stroke-width="3"/>
              <text x="66" y="59" font-family="'Plus Jakarta Sans', sans-serif" font-size="19" font-weight="700" fill="#9b5cff" text-anchor="middle">?</text>
              <rect x="40" y="30" width="10" height="10" fill="#ffd966" transform="rotate(45 45 35)"/>
            </svg>
          </div>
        </button>

      </div>

      <!-- Played Games Section -->
      <section class="mt-12" id="played-games">
        <div class="flex items-end justify-between mb-4">
          <div>
            <h3 class="font-display text-xl font-bold text-[var(--text)]">Played Games</h3>
            <p class="text-[var(--muted)] text-sm mt-0.5">Pick up where you left off.</p>
          </div>
          <div class="flex gap-2" data-scroll-controls>
            <button class="w-9 h-9 rounded-xl flex items-center justify-center bg-[var(--surface)] border border-[var(--border)] text-[var(--muted)] hover:border-[var(--secondary)] hover:text-[var(--secondary)] hover:shadow-[0_0_12px_rgba(34,211,238,0.35)] transition-all" data-dir="-1" aria-label="Scroll left">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="w-9 h-9 rounded-xl flex items-center justify-center bg-[var(--surface)] border border-[var(--border)] text-[var(--muted)] hover:border-[var(--secondary)] hover:text-[var(--secondary)] hover:shadow-[0_0_12px_rgba(34,211,238,0.35)] transition-all" data-dir="1" aria-label="Scroll right">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>

        <div class="flex gap-4 overflow-x-auto p-1 scroll-smooth snap-x snap-proximity" data-row>

          <button type="button" class="snap-start shrink-0 w-48 flex flex-col items-start gap-3 bg-[var(--surface)] border border-[var(--border)] rounded-2xl p-4 text-left hover:-translate-y-1 hover:border-[var(--primary)]/60 hover:shadow-[0_8px_24px_rgba(155,92,255,0.20)] transition-all cursor-pointer group" style="--tint: rgba(155,92,255,0.16);">
            <span class="w-12 h-12 rounded-2xl text-2xl flex items-center justify-center transition" style="background: var(--tint);">🧠</span>
            <span class="font-display font-bold text-base leading-snug text-[var(--text)]">General Knowledge</span>
            <span class="text-xs font-bold text-[var(--secondary)] bg-white/5 border border-[var(--border)] px-2.5 py-1 rounded-full">Trivia</span>
          </button>

          <button type="button" class="snap-start shrink-0 w-48 flex flex-col items-start gap-3 bg-[var(--surface)] border border-[var(--border)] rounded-2xl p-4 text-left hover:-translate-y-1 hover:border-[var(--secondary)]/60 hover:shadow-[0_8px_24px_rgba(34,211,238,0.20)] transition-all cursor-pointer group" style="--tint: rgba(34,211,238,0.16);">
            <span class="w-12 h-12 rounded-2xl text-2xl flex items-center justify-center transition" style="background: var(--tint);">🔬</span>
            <span class="font-display font-bold text-base leading-snug text-[var(--text)]">Science Sprint</span>
            <span class="text-xs font-bold text-[var(--secondary)] bg-white/5 border border-[var(--border)] px-2.5 py-1 rounded-full">Science</span>
          </button>

          <button type="button" class="snap-start shrink-0 w-48 flex flex-col items-start gap-3 bg-[var(--surface)] border border-[var(--border)] rounded-2xl p-4 text-left hover:-translate-y-1 hover:border-[#4d7bff]/60 hover:shadow-[0_8px_24px_rgba(77,123,255,0.20)] transition-all cursor-pointer group" style="--tint: rgba(77,123,255,0.16);">
            <span class="w-12 h-12 rounded-2xl text-2xl flex items-center justify-center transition" style="background: var(--tint);">🌍</span>
            <span class="font-display font-bold text-base leading-snug text-[var(--text)]">World Capitals</span>
            <span class="text-xs font-bold text-[var(--secondary)] bg-white/5 border border-[var(--border)] px-2.5 py-1 rounded-full">Geography</span>
          </button>

          <button type="button" class="snap-start shrink-0 w-48 flex flex-col items-start gap-3 bg-[var(--surface)] border border-[var(--border)] rounded-2xl p-4 text-left hover:-translate-y-1 hover:border-[#ec4899]/60 hover:shadow-[0_8px_24px_rgba(236,72,153,0.20)] transition-all cursor-pointer group" style="--tint: rgba(236,72,153,0.16);">
            <span class="w-12 h-12 rounded-2xl text-2xl flex items-center justify-center transition" style="background: var(--tint);">🎬</span>
            <span class="font-display font-bold text-base leading-snug text-[var(--text)]">Movie Mania</span>
            <span class="text-xs font-bold text-[var(--secondary)] bg-white/5 border border-[var(--border)] px-2.5 py-1 rounded-full">Media</span>
          </button>

          <button type="button" class="snap-start shrink-0 w-48 flex flex-col items-start gap-3 bg-[var(--surface)] border border-[var(--border)] rounded-2xl p-4 text-left hover:-translate-y-1 hover:border-[var(--primary)]/60 hover:shadow-[0_8px_24px_rgba(155,92,255,0.20)] transition-all cursor-pointer group" style="--tint: rgba(155,92,255,0.16);">
            <span class="w-12 h-12 rounded-2xl text-2xl flex items-center justify-center transition" style="background: var(--tint);">⚽</span>
            <span class="font-display font-bold text-base leading-snug text-[var(--text)]">Sports Legends</span>
            <span class="text-xs font-bold text-[var(--secondary)] bg-white/5 border border-[var(--border)] px-2.5 py-1 rounded-full">Sports</span>
          </button>

          <button type="button" class="snap-start shrink-0 w-48 flex flex-col items-start gap-3 bg-[var(--surface)] border border-[var(--border)] rounded-2xl p-4 text-left hover:-translate-y-1 hover:border-[var(--secondary)]/60 hover:shadow-[0_8px_24px_rgba(34,211,238,0.20)] transition-all cursor-pointer group" style="--tint: rgba(34,211,238,0.16);">
            <span class="w-12 h-12 rounded-2xl text-2xl flex items-center justify-center transition" style="background: var(--tint);">➗</span>
            <span class="font-display font-bold text-base leading-snug text-[var(--text)]">Math Master</span>
            <span class="text-xs font-bold text-[var(--secondary)] bg-white/5 border border-[var(--border)] px-2.5 py-1 rounded-full">Maths</span>
          </button>
        </div>
      </section>

      <!-- Top Choice Section -->
      <section class="mt-12" id="top-choice">
        <div class="flex items-end justify-between mb-4">
          <div>
            <h3 class="font-display text-xl font-bold text-[var(--text)]">Top Choice</h3>
            <p class="text-[var(--muted)] text-sm mt-0.5">Loved by the community this week.</p>
          </div>
          <div class="flex gap-2" data-scroll-controls>
            <button class="w-9 h-9 rounded-xl flex items-center justify-center bg-[var(--surface)] border border-[var(--border)] text-[var(--muted)] hover:border-[var(--secondary)] hover:text-[var(--secondary)] hover:shadow-[0_0_12px_rgba(34,211,238,0.35)] transition-all" data-dir="-1" aria-label="Scroll left">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="w-9 h-9 rounded-xl flex items-center justify-center bg-[var(--surface)] border border-[var(--border)] text-[var(--muted)] hover:border-[var(--secondary)] hover:text-[var(--secondary)] hover:shadow-[0_0_12px_rgba(34,211,238,0.35)] transition-all" data-dir="1" aria-label="Scroll right">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>

        <div class="flex gap-4 overflow-x-auto p-1 scroll-smooth snap-x snap-proximity" data-row>
